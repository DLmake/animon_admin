APP_NAME=Animon
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Vagrant: uses the 192.168.56.10 private network; Multipass: uses the VM's own IP
APP_URL=http://{{ (ansible_all_ipv4_addresses | select('match', '^192\\.168\\.56\\.') | list + [ansible_default_ipv4.address]) | first }}

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE={{ db_name }}
DB_USERNAME={{ db_user }}
DB_PASSWORD={{ db_pass }}

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=database
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
